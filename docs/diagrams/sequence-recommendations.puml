@startuml sequence-recommendations
title Поток "жалоба → рекомендация" (POST /api/v1/recommendations, v2)

actor "Пилот" as pilot
participant "Frontend" as fe
participant "Setup Recommendation\nService (FastAPI)" as svc
database "SQLite" as db

pilot -> fe : выбирает car/track/symptom_type/\ncorner_phase/stint_moment,\nпишет comment
fe -> svc : POST /api/v1/recommendations\n{car, track, symptom_type,\ncorner_phase, stint_moment?, comment}
activate svc

svc -> svc : валидация запроса\n(обязательные поля, comment 3–500)

alt запрос невалиден
    svc --> fe : 400 {status: error,\nerror.code: validation_error}
    fe --> pilot : показывает ошибку у полей (error.fields)
else запрос валиден
    svc -> db : SELECT rules\nWHERE status = allowed
    activate db
    db --> svc : разрешённые правила
    deactivate db

    svc -> svc : точное совпадение symptom_type/\ncorner_phase/stint_moment,\ncar/track ∈ applicability

    svc -> db : INSERT requests\n(запрос + исход)
    activate db
    db --> svc : ok
    deactivate db

    alt совпадение найдено
        svc --> fe : 200 {status: match, request_id,\nrecommendations: [...] (≤3)}
        fe --> pilot : показывает карточки рекомендаций
    else совпадений нет
        svc --> fe : 200 {status: no_match, request_id,\nmessage: "..."}
        fe --> pilot : "подходящее правило не найдено"
    end
end

deactivate svc

@enduml
